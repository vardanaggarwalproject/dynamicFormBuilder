{
  "title": "User Profile Extended",
  "index": [
    {
      "name": "email",
      "type": "email",
      "label": "Email",
      "required": true
    },
    {
      "name": "password",
      "type": "password",
      "label": "Password",
      "min": 8,
      "max": 16,
      "required": true
    },
    {
      "name": "age",
      "type": "number",
      "label": "Age",
      "min": 18,
      "max": 100,
      "required": true
    },
    {
      "name": "fullName",
      "type": "text",
      "label": "Full Name",
      "min": 2,
      "max": 30
    },
    {
      "name": "bio",
      "type": "textarea",
      "label": "Bio",
      "max": 200
    },
    {
      "name": "role",
      "type": "select",
      "label": "Role",
      "options": ["Admin", "User", "Guest"]
    },
    {
      "name": "gender",
      "label": "Gender",
      "type": "radio",
      "required": true,
      "options": ["Male", "Female"]
    },
    {
      "name": "skills",
      "label": "Skills",
      "type": "checkbox",
      "required": true,
      "multiple": true,
      "options": ["React", "Node", "MongoDB", "Next.js"]
    },
    {
      "name": "dob",
      "type": "date",
      "label": "Date of Birth"
    },
    {
      "name": "resume",
      "type": "file",
      "label": "Upload Resume",
      "accept": ".pdf,.doc,.docx"
    },
    {
      "name": "terms",
      "type": "checkbox-single",
      "label": "I agree to the Terms & Conditions",
      "required": true
    },
    {
      "name": "rating",
      "type": "range",
      "label": "Experience Level",
      "min": 1,
      "max": 10
    }
  ]
}
